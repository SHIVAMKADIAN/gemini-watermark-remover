# Copy to .env and adjust. All settings use the WM_ prefix.

WM_DATA_DIR=./data
WM_MAX_UPLOAD_MB=512

# memory | redis
WM_QUEUE_BACKEND=memory
WM_REDIS_URL=redis://localhost:6379/0
WM_WORKER_CONCURRENCY=1

# auto (prefer GPU model, fall back to classical) | lama | classical
WM_IMAGE_BACKEND=auto
# auto (prefer ProPainter, fall back to classical) | propainter | classical
WM_VIDEO_BACKEND=auto

# cpu | cuda
WM_DEVICE=cpu

# --- GPU model backends (optional) ---------------------------------------
# LaMa (IOPaint). Needs `pip install '.[lama]'` + a GPU for real speed.
WM_LAMA_MODEL=lama
# Original | Resize | Crop  (how IOPaint handles very large images)
WM_LAMA_HD_STRATEGY=Crop

# ProPainter (S-Lab NON-COMMERCIAL — not vendored). Point this at your own
# clone of https://github.com/sczhou/ProPainter with weights fetched per its
# README; the adapter drives its inference_propainter.py as a subprocess.
# Leave empty to keep the classical video fallback.
WM_PROPAINTER_DIR=
# Python used to run ProPainter (empty = this interpreter). Use a separate env
# if ProPainter pins torch versions that clash with the server's.
WM_PROPAINTER_PYTHON=
WM_PROPAINTER_NEIGHBOR_LENGTH=10
WM_PROPAINTER_REF_STRIDE=10
WM_PROPAINTER_SUBVIDEO_LENGTH=80
WM_PROPAINTER_RAFT_ITER=20
WM_PROPAINTER_FP16=true
WM_PROPAINTER_TIMEOUT_S=3600
