# GPU image — FastAPI + OpenCV + vidfill + FFmpeg + LaMa (IOPaint) on CUDA.
#
# Build from the repo root so the sibling vidfill/ is in context:
#   docker build -f server/Dockerfile.gpu -t wmserver-gpu .
#   docker run --gpus all -p 8000:8000 -e WM_DEVICE=cuda wmserver-gpu
#
# LaMa (image) works out of the box here. ProPainter (video) is S-Lab
# NON-COMMERCIAL and is NOT bundled — mount your own checkout + weights and set
# WM_PROPAINTER_DIR:
#   docker run --gpus all -p 8000:8000 \
#     -e WM_DEVICE=cuda -e WM_PROPAINTER_DIR=/propainter \
#     -v /abs/path/to/ProPainter:/propainter wmserver-gpu
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv ffmpeg git \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY vidfill /app/vidfill
COPY server /app/server
# Install the service + LaMa extra (torch + iopaint). Torch pulls its own CUDA
# runtime wheels; the base image supplies the driver-facing libraries.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e /app/vidfill -e '/app/server[lama]'

ENV WM_DATA_DIR=/data
ENV WM_DEVICE=cuda
VOLUME ["/data"]
EXPOSE 8000

CMD ["wmserver", "--host", "0.0.0.0", "--port", "8000"]
